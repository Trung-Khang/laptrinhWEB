<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><title>Thống kê</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><style>body{background:#f4f6f9}.layout{display:flex}.side{width:260px;min-height:100vh;background:linear-gradient(180deg,#007bff,#0056b3);color:#fff;padding:24px}.side a{display:block;color:#dbeafe;text-decoration:none;padding:12px;border-radius:8px}.side a.active,.side a:hover{background:rgba(255,255,255,.18);color:#fff}.main{flex:1;padding:28px}.card{border:0;border-radius:12px;box-shadow:0 4px 18px rgba(0,0,0,.06)}</style></head><body><div class="layout"><aside class="side"><h4>Admin Panel</h4><p>Quản trị cửa hàng</p><hr><a href="${pageContext.request.contextPath}/admin/category/list">Quản lý Danh mục</a><a href="${pageContext.request.contextPath}/admin/product/list">Quản lý Sản phẩm</a><a href="${pageContext.request.contextPath}/admin/order/list">Quản lý Đơn hàng</a><a href="${pageContext.request.contextPath}/admin/user/list">Quản lý Người dùng</a><a class="active" href="${pageContext.request.contextPath}/admin/statistics">Thống kê</a></aside><main class="main"><h3 class="mb-3">Thống kê sản phẩm</h3><div class="row g-3 mb-3"><div class="col-md-3"><div class="card"><div class="card-body"><span>Tổng sản phẩm</span><h3>${totalProducts}</h3></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><span>Tổng tồn kho</span><h3>${totalStock}</h3></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><span>Sắp hết hàng</span><h3>${lowStock}</h3></div></div></div><div class="col-md-3"><div class="card"><div class="card-body"><span>Hết hàng</span><h3>${outOfStock}</h3></div></div></div></div><div class="card mb-3"><div class="card-body"><h5>Giá trị tồn kho: <fmt:formatNumber value="${inventoryValue}" type="number"/> đ</h5></div></div><div class="row g-3"><div class="col-md-4"><div class="card"><div class="card-body"><h5>Sản phẩm theo danh mục</h5><table class="table"><c:forEach items="${productByCategory}" var="r"><tr><td>${r[0]}</td><td class="text-end">${r[1]}</td></tr></c:forEach></table></div></div></div><div class="col-md-4"><div class="card"><div class="card-body"><h5>Sắp hết hàng</h5><table class="table"><c:forEach items="${lowStockProducts}" var="r"><tr><td>${r[0]}</td><td class="text-end">${r[1]}</td></tr></c:forEach></table></div></div></div><div class="col-md-4"><div class="card"><div class="card-body"><h5>Top bán chạy</h5><table class="table"><c:forEach items="${topSellingProducts}" var="r"><tr><td>${r[0]}</td><td class="text-end">${r[1]}</td></tr></c:forEach></table></div></div></div></div></main></div></body></html>
