<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<% request.setAttribute("pageTitle", "Thống kê sản phẩm"); request.setAttribute("activeMenu", "statistics"); %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Thống kê | KhangGear</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin-layout.css"></head><body><div class="admin-layout"><%@ include file="fragments/sidebar.jsp" %><div class="admin-main"><%@ include file="fragments/header.jsp" %><main class="admin-content"><div class="row g-3 mb-4"><div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><small>Tổng sản phẩm</small><h2>${totalProducts}</h2></div></div></div><div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><small>Tổng tồn kho</small><h2>${totalStock}</h2></div></div></div><div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><small>Sắp hết hàng</small><h2>${lowStock}</h2></div></div></div><div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><small>Hết hàng</small><h2>${outOfStock}</h2></div></div></div></div><div class="card mb-3"><div class="card-body">Giá trị tồn kho: <strong><fmt:formatNumber value="${inventoryValue}" type="number"/> đ</strong></div></div><div class="row g-3"><div class="col-lg-4"><div class="card h-100"><div class="card-body"><h5>Sản phẩm theo danh mục</h5><table class="table"><c:forEach items="${productByCategory}" var="row"><tr><td><c:out value="${row[0]}"/></td><td class="text-end">${row[1]}</td></tr></c:forEach></table></div></div></div><div class="col-lg-4"><div class="card h-100"><div class="card-body"><h5>Sắp hết hàng</h5><table class="table"><c:forEach items="${lowStockProducts}" var="row"><tr><td><c:out value="${row[0]}"/></td><td class="text-end">${row[1]}</td></tr></c:forEach></table></div></div></div><div class="col-lg-4"><div class="card h-100"><div class="card-body"><h5>Top bán chạy</h5><table class="table"><c:forEach items="${topSellingProducts}" var="row"><tr><td><c:out value="${row[0]}"/></td><td class="text-end">${row[1]}</td></tr></c:forEach></table></div></div></div></div></main></div></div></body></html>
