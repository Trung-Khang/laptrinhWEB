<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><title>Sửa người dùng</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><style>body{background:#f4f6f9}.wrap{max-width:760px;margin:32px auto}.card{border:0;border-radius:12px;box-shadow:0 4px 18px rgba(0,0,0,.06)}</style></head><body><main class="wrap"><a class="btn btn-outline-secondary btn-sm mb-3" href="${pageContext.request.contextPath}/admin/user/list">Quay lại</a><c:if test="${empty user}"><div class="alert alert-danger">Không tìm thấy người dùng.</div></c:if><c:if test="${not empty user}"><div class="card"><div class="card-body"><h4>Sửa người dùng</h4><form method="post" class="row g-3"><input type="hidden" name="id" value="${user.id}"><div class="col-md-6"><label class="form-label">Username</label><input value="${user.userName}" class="form-control" disabled></div><div class="col-md-6"><label class="form-label">Email</label><input name="email" type="email" value="${user.email}" class="form-control" required></div><div class="col-md-6"><label class="form-label">Họ tên</label><input name="fullname" value="${user.fullName}" class="form-control"></div><div class="col-md-6"><label class="form-label">SĐT</label><input name="phone" value="${user.phone}" class="form-control"></div><div class="col-md-6"><label class="form-label">Role</label><select name="roleid" class="form-select"><option value="1" ${user.roleid == 1 ? 'selected' : ''}>ADMIN</option><option value="3" ${user.roleid != 1 ? 'selected' : ''}>CUSTOMER</option></select></div><div class="col-md-6"><label class="form-label">Trạng thái</label><select name="active" class="form-select"><option value="true" ${user.active ? 'selected' : ''}>Hoạt động</option><option value="false" ${!user.active ? 'selected' : ''}>Khóa</option></select></div><div class="col-12"><button class="btn btn-primary">Cập nhật</button></div></form></div></div></c:if></main></body></html>
