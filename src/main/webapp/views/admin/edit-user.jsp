<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><title>Sửa người dùng</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body class="bg-light"><main class="container py-4"><a href="${pageContext.request.contextPath}/admin/user/list">Quay lại</a><h2>Sửa người dùng</h2><c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if><form method="post" class="row g-3"><input name="id" type="hidden" value="${editingUser.id}"><div class="col-md-6"><label class="form-label">Username</label><input class="form-control" disabled value="${editingUser.userName}"></div><div class="col-md-6"><label class="form-label">Mật khẩu mới</label><input name="password" type="password" class="form-control"><small>Để trống để giữ mật khẩu cũ.</small></div><div class="col-md-6"><label class="form-label">Email *</label><input name="email" type="email" required class="form-control" value="${editingUser.email}"></div><div class="col-md-6"><label class="form-label">Họ tên</label><input name="fullname" class="form-control" value="${editingUser.fullName}"></div><div class="col-md-6"><label class="form-label">SĐT</label><input name="phone" class="form-control" value="${editingUser.phone}"></div><div class="col-md-3"><label class="form-label">Role</label><select name="roleid" class="form-select"><option value="1" ${editingUser.roleid == 1 ? 'selected' : ''}>ADMIN</option><option value="2" ${editingUser.roleid == 2 ? 'selected' : ''}>MANAGER</option><option value="3" ${editingUser.roleid == 3 ? 'selected' : ''}>CUSTOMER</option></select></div><div class="col-md-3"><label class="form-label">Trạng thái</label><select name="active" class="form-select"><option value="true" ${editingUser.active ? 'selected' : ''}>Hoạt động</option><option value="false" ${!editingUser.active ? 'selected' : ''}>Khóa</option></select></div><div><button class="btn btn-primary">Cập nhật</button></div></form></main></body></html>
