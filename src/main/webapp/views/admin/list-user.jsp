<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<% request.setAttribute("pageTitle", "Quản lý người dùng"); request.setAttribute("activeMenu", "user"); %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Quản lý người dùng</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin-layout.css"></head><body><div class="admin-layout"><%@ include file="fragments/sidebar.jsp" %><div class="admin-main"><%@ include file="fragments/header.jsp" %><main class="admin-content">
<c:if test="${not empty flashSuccess}"><div class="alert alert-success"><c:out value="${flashSuccess}"/></div></c:if><c:if test="${not empty flashError || not empty error}"><div class="alert alert-danger"><c:out value="${not empty error ? error : flashError}"/></div></c:if>
<div class="d-flex justify-content-between mb-3"><form class="row g-2"><div class="col"><input class="form-control" name="keyword" value="${param.keyword}" placeholder="Tìm username, họ tên, email"></div><div class="col"><select class="form-select" name="roleid"><option value="">Tất cả role</option><option value="1" ${param.roleid == '1' ? 'selected' : ''}>ADMIN</option><option value="2" ${param.roleid == '2' ? 'selected' : ''}>MANAGER</option><option value="3" ${param.roleid == '3' ? 'selected' : ''}>CUSTOMER</option></select></div><div class="col"><select class="form-select" name="active"><option value="">Tất cả trạng thái</option><option value="true" ${param.active == 'true' ? 'selected' : ''}>Hoạt động</option><option value="false" ${param.active == 'false' ? 'selected' : ''}>Đã khóa</option></select></div><div class="col-auto"><button class="btn btn-secondary">Tìm</button></div></form><a class="btn btn-primary" href="${pageContext.request.contextPath}/admin/user/add">Thêm người dùng</a></div>
<table class="table table-bordered bg-white"><thead><tr><th>ID</th><th>Username</th><th>Họ tên</th><th>Email</th><th>SĐT</th><th>Role</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${users}" var="u"><tr><td>${u.id}</td><td><c:out value="${u.userName}"/></td><td><c:out value="${u.fullName}"/></td><td><c:out value="${u.email}"/></td><td><c:out value="${u.phone}"/></td><td>${u.roleid == 1 ? 'ADMIN' : u.roleid == 2 ? 'MANAGER' : 'CUSTOMER'}</td><td>${u.active ? 'Hoạt động' : 'Đã khóa'}</td><td><a class="btn btn-sm btn-outline-primary" href="${pageContext.request.contextPath}/admin/user/edit?id=${u.id}">Sửa</a> <form class="d-inline" method="post" action="${pageContext.request.contextPath}/admin/user/toggle"><input type="hidden" name="id" value="${u.id}"><input type="hidden" name="active" value="${!u.active}"><button class="btn btn-sm btn-outline-warning" onclick="return confirm('Cập nhật trạng thái tài khoản?')">${u.active ? 'Khóa' : 'Mở khóa'}</button></form></td></tr></c:forEach><c:if test="${empty users}"><tr><td colspan="8" class="text-center">Chưa có người dùng.</td></tr></c:if></tbody></table>
</main></div></div></body></html>
