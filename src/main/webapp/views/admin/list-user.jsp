<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Quản lý Người dùng | Admin</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"><style>body{background:#f4f6f9}.layout{display:flex}.side{width:260px;min-height:100vh;background:linear-gradient(180deg,#007bff,#0056b3);color:#fff;padding:24px}.side a{display:block;color:#dbeafe;text-decoration:none;padding:12px;border-radius:8px}.side a.active,.side a:hover{background:rgba(255,255,255,.18);color:#fff}.main{flex:1;padding:28px}.card{border:0;border-radius:12px;box-shadow:0 4px 18px rgba(0,0,0,.06)}</style></head><body><div class="layout"><aside class="side"><h4>Admin Panel</h4><p>Quản trị cửa hàng</p><hr><a href="${pageContext.request.contextPath}/admin/category/list">Quản lý Danh mục</a><a href="${pageContext.request.contextPath}/admin/product/list">Quản lý Sản phẩm</a><a href="${pageContext.request.contextPath}/admin/order/list">Quản lý Đơn hàng</a><a class="active" href="${pageContext.request.contextPath}/admin/user/list">Quản lý Người dùng</a><a href="${pageContext.request.contextPath}/admin/statistics">Thống kê</a></aside><main class="main"><div class="d-flex justify-content-between align-items-center mb-3"><h3>Quản lý Người dùng</h3><a href="${pageContext.request.contextPath}/logout" class="btn btn-outline-danger btn-sm">Đăng xuất</a></div><c:if test="${not empty param.message}"><div class="alert alert-success"><c:out value="${param.message}"/></div></c:if><c:if test="${not empty param.error}"><div class="alert alert-danger"><c:out value="${param.error}"/></div></c:if><div class="card"><div class="card-body"><div class="d-flex justify-content-between gap-2 mb-3"><form class="row g-2 flex-grow-1"><div class="col-md-5"><input class="form-control" name="keyword" value="${param.keyword}" placeholder="Tìm username, họ tên, email..."></div><div class="col-md-3"><select class="form-select" name="roleid"><option value="">Tất cả role</option><option value="1" ${param.roleid == '1' ? 'selected' : ''}>ADMIN</option><option value="3" ${param.roleid == '3' ? 'selected' : ''}>CUSTOMER</option></select></div><div class="col-md-3"><select class="form-select" name="active"><option value="">Tất cả trạng thái</option><option value="true" ${param.active == 'true' ? 'selected' : ''}>Hoạt động</option><option value="false" ${param.active == 'false' ? 'selected' : ''}>Đã khóa</option></select></div><div class="col-md-1"><button class="btn btn-outline-secondary w-100"><i class="fa-solid fa-search"></i></button></div></form><a href="${pageContext.request.contextPath}/admin/user/add" class="btn btn-primary">Thêm</a></div><table class="table table-hover align-middle"><thead><tr><th>ID</th><th>Username</th><th>Họ tên</th><th>Email</th><th>SĐT</th><th>Role</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${users}" var="u"><tr><td>${u.id}</td><td><c:out value="${u.userName}"/></td><td><c:out value="${u.fullName}"/></td><td><c:out value="${u.email}"/></td><td><c:out value="${u.phone}"/></td><td>${u.roleid == 1 ? 'ADMIN' : 'CUSTOMER'}</td><td><span class="badge ${u.active ? 'text-bg-success' : 'text-bg-secondary'}">${u.active ? 'Hoạt động' : 'Đã khóa'}</span></td><td><a class="btn btn-sm btn-outline-primary" href="${pageContext.request.contextPath}/admin/user/edit?id=${u.id}">Sửa</a> <a onclick="return confirm('Cập nhật trạng thái tài khoản?')" class="btn btn-sm btn-outline-warning" href="${pageContext.request.contextPath}/admin/user/toggle?id=${u.id}&active=${!u.active}">${u.active ? 'Khóa' : 'Mở'}</a></td></tr></c:forEach><c:if test="${empty users}"><tr><td colspan="8" class="text-center text-muted py-4">Chưa có người dùng.</td></tr></c:if></tbody></table></div></div></main></div></body></html>
