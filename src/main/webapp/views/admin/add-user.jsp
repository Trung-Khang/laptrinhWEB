<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<% request.setAttribute("pageTitle", "Thêm người dùng"); request.setAttribute("activeMenu", "user"); %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Thêm người dùng</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/admin-layout.css"></head><body><div class="admin-layout"><%@ include file="fragments/sidebar.jsp" %><div class="admin-main"><%@ include file="fragments/header.jsp" %><main class="admin-content"><div class="container-fluid"><a href="${pageContext.request.contextPath}/admin/user/list">Quay lại</a><h2 class="h4 mt-3">Thêm người dùng</h2><c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if><form method="post" class="row g-3"><div class="col-md-6"><label class="form-label">Username *</label><input name="username" required class="form-control" value="${formUser.userName}"></div><div class="col-md-6"><label class="form-label">Mật khẩu *</label><input name="password" type="password" required class="form-control"></div><div class="col-md-6"><label class="form-label">Email *</label><input name="email" type="email" required class="form-control" value="${formUser.email}"></div><div class="col-md-6"><label class="form-label">Họ tên</label><input name="fullname" class="form-control" value="${formUser.fullName}"></div><div class="col-md-6"><label class="form-label">SĐT</label><input name="phone" class="form-control" value="${formUser.phone}"></div><div class="col-md-3"><label class="form-label">Role</label><select name="roleid" class="form-select"><option value="1">ADMIN</option><option value="2">MANAGER</option><option value="3" selected>CUSTOMER</option></select></div><div class="col-md-3"><label class="form-label">Trạng thái</label><select name="active" class="form-select"><option value="true">Hoạt động</option><option value="false">Khóa</option></select></div><div><button class="btn btn-primary">Lưu</button></div></form></div></main></div></div></body></html>
