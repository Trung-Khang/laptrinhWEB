<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Xác minh OTP | KhangGear</title><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/auth.css"></head><body class="auth-page"><main class="auth-overlay"><section class="auth-card"><img class="auth-brand" src="<%=request.getContextPath()%>/assets/images/khanggear-logo.png" alt="KhangGear"><h1>Xác minh OTP</h1><p class="auth-subtitle">Nhập mã OTP để tiếp tục đặt lại mật khẩu.</p><% if (request.getAttribute("error") != null) { %><p class="auth-alert"><%=request.getAttribute("error")%></p><% } %><% if (request.getAttribute("message") != null) { %><p class="auth-alert auth-success"><%=request.getAttribute("message")%></p><% } %><form action="<%=request.getContextPath()%>/forgot-password/verify" method="post"><div class="auth-field"><input class="otp-input" data-otp-input name="otp" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required aria-label="Mã OTP 6 chữ số"></div><button class="auth-submit" type="submit">Xác minh OTP</button></form><form action="<%=request.getContextPath()%>/forgot-password/verify" method="post"><input type="hidden" name="action" value="resend"><button class="auth-secondary" type="submit" data-resend-countdown>Gửi lại OTP</button></form></section></main><script src="<%=request.getContextPath()%>/assets/js/auth.js"></script></body></html>
