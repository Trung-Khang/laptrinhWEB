<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Đăng nhập | KhangGear</title><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/auth.css"></head><body class="auth-page"><main class="auth-overlay"><section class="auth-card"><img class="auth-brand" src="<%=request.getContextPath()%>/assets/images/khanggear-logo.png" alt="KhangGear"><h1>Đăng nhập</h1><p class="auth-subtitle">Chào mừng bạn quay lại KhangGear</p><% if ("1".equals(request.getParameter("verified"))) { %><p class="auth-alert auth-success">Xác minh email thành công. Bạn có thể đăng nhập ngay.</p><% } %><% if ("1".equals(request.getParameter("reset"))) { %><p class="auth-alert auth-success">Đặt lại mật khẩu thành công. Hãy đăng nhập bằng mật khẩu mới.</p><% } %><% if (request.getAttribute("error") != null) { %><p class="auth-alert"><%=request.getAttribute("error")%></p><% } %><form action="<%=request.getContextPath()%>/login" method="post"><div class="auth-field"><label for="username">Tên đăng nhập</label><div class="input-wrap"><i class="fa-solid fa-user"></i><input id="username" name="username" required value="<%=request.getAttribute("username") != null ? request.getAttribute("username") : request.getAttribute("rememberedUsername") != null ? request.getAttribute("rememberedUsername") : ""%>" autocomplete="username"></div></div><div class="auth-field"><label for="password">Mật khẩu</label><div class="input-wrap"><i class="fa-solid fa-lock"></i><input id="password" name="password" type="password" required autocomplete="current-password"><button class="password-toggle" type="button" data-password-toggle="password" aria-label="Hiện mật khẩu"><i class="fa-solid fa-eye"></i></button></div></div><label class="auth-options"><input name="remember" type="checkbox" value="1"> Ghi nhớ tên đăng nhập</label><button class="auth-submit" type="submit">Đăng nhập</button></form><p class="auth-footer"><a href="<%=request.getContextPath()%>/forgot-password">Quên mật khẩu?</a></p><% if (request.getAttribute("verificationRequired") != null) { %><p class="auth-footer"><a href="<%=request.getContextPath()%>/verify-email">Nhập hoặc gửi lại mã OTP</a></p><% } %><p class="auth-footer">Chưa có tài khoản? <a href="<%=request.getContextPath()%>/register">Đăng ký</a></p></section></main><script src="<%=request.getContextPath()%>/assets/js/auth.js"></script></body></html>
