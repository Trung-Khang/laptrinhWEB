<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Quên mật khẩu | KhangGear</title><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/auth.css"></head><body class="auth-page"><main class="auth-overlay"><section class="auth-card"><img class="auth-brand" src="<%=request.getContextPath()%>/assets/images/khanggear-logo.png" alt="KhangGear"><h1>Quên mật khẩu</h1><p class="auth-subtitle">Nhập email để nhận mã OTP đặt lại mật khẩu.</p><% if (request.getAttribute("message") != null) { %><p class="auth-alert auth-success"><%=request.getAttribute("message")%></p><% } %><form action="<%=request.getContextPath()%>/forgot-password" method="post"><div class="auth-field"><label for="email">Email</label><div class="input-wrap"><i class="fa-solid fa-envelope"></i><input id="email" name="email" type="email" required autocomplete="email"></div></div><button class="auth-submit" type="submit">Gửi mã OTP</button></form><p class="auth-footer"><a href="<%=request.getContextPath()%>/login">Quay lại đăng nhập</a></p></section></main><script src="<%=request.getContextPath()%>/assets/js/auth.js"></script></body></html>
