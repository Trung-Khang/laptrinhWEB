<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

  <!-- Persistence unit dùng cho assignment JPA/Hibernate.
       Tên unit `jpa-hibernate-mysql` giữ theo ví dụ của giảng viên,
       nhưng cấu hình database thực tế là SQL Server đang chạy. -->
  <persistence-unit name="jpa-hibernate-mysql">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

    <class>vn.iotstar.entity.Category</class>
    <class>vn.iotstar.entity.Video</class>
    <class>vn.iotstar.entity.Product</class>

    <properties>
      <!-- Kết nối SQL Server (ShoppingServiceMVC) của project hiện tại -->
      <property name="jakarta.persistence.jdbc.driver" value="com.microsoft.sqlserver.jdbc.SQLServerDriver"/>
      <property name="jakarta.persistence.jdbc.url"
                value="jdbc:sqlserver://127.0.0.1:52282;databaseName=ShoppingServiceMVC;encrypt=false;trustServerCertificate=true"/>
      <property name="jakarta.persistence.jdbc.user" value="sa"/>
      <property name="jakarta.persistence.jdbc.password" value="trungkhang"/>

      <!-- Dialect SQL Server hợp lệ cho Hibernate 6.6 -->
      <property name="hibernate.dialect" value="org.hibernate.dialect.SQLServerDialect"/>

      <property name="hibernate.show_sql" value="true"/>
      <property name="hibernate.format_sql" value="true"/>
      <property name="hibernate.hbm2ddl.auto" value="update"/>
    </properties>
  </persistence-unit>

</persistence>
